# ==========================================
# CONFIGURAZIONE SORGENTE DATI
# ==========================================
# Opzioni: 'mock' | 'supabase' | 'api'
# - mock: Usa dati hardcoded (per demo senza backend)
# - supabase: Usa database Supabase (consigliato per test)
# - api: Usa API REST custom
VITE_DATA_SOURCE=mock

# ==========================================
# SUPABASE (se VITE_DATA_SOURCE=supabase)
# ==========================================
# Project URL (es: https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# anon/public API key (copia da Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=

# ==========================================
# API CUSTOM (se VITE_DATA_SOURCE=api)
# ==========================================
# URL base per le API REST
VITE_API_BASE_URL=http://localhost:8000/api/v1
